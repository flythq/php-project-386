{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "tsp:build": "npm --prefix typespec run build && npm run sdk:build",
        "tsp:smoke": "npm --prefix typespec run smoke",
        "sdk:build": "openapi-typescript api/openapi/openapi.yaml -o resources/js/api/schema.d.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "openapi-typescript": "^7.13.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
